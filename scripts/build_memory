################################################################
# This is a generated script based on design: design_1
#
# Modified to open an existing block design instead of failing.
################################################################

namespace eval _tcl {
proc get_script_folder {} {
   set script_path [file normalize [info script]]
   set script_folder [file dirname $script_path]
   return $script_folder
}
}
variable script_folder
set script_folder [_tcl::get_script_folder]

################################################################
# Check if script is running in correct Vivado version.
################################################################
set scripts_vivado_version 2024.2
set current_vivado_version [version -short]

if { [string first $scripts_vivado_version $current_vivado_version] == -1 } {
   puts ""
   if { [string compare $scripts_vivado_version $current_vivado_version] > 0 } {
      catch {common::send_gid_msg -ssname BD::TCL -id 2042 -severity "ERROR" " This script was generated using Vivado <$scripts_vivado_version> and is being run in <$current_vivado_version> of Vivado. Sourcing the script failed since it was created with a future version of Vivado."}
   } else {
     catch {common::send_gid_msg -ssname BD::TCL -id 2041 -severity "ERROR" "This script was generated using Vivado <$scripts_vivado_version> and is being run in <$current_vivado_version> of Vivado. Please run the script in Vivado <$scripts_vivado_version> then open the design in Vivado <$current_vivado_version>. Upgrade the design by running \"Tools => Report => Report IP Status...\", then run write_bd_tcl to create an updated script."}
   }
   return 1
}

################################################################
# START
################################################################

set list_projs [get_projects -quiet]
if { $list_projs eq "" } {
   create_project work work -part xc7z020clg400-1
   add_files -fileset constrs_1 xdc/Zybo-Z7-Master.xdc
}

# CHANGE DESIGN NAME HERE
variable design_name
set design_name design_1

set run_remote_bd_flow 1
set design_opened 0

if { $run_remote_bd_flow == 1 } {
  set origin_dir ./bd
  if { [info exists ::origin_dir_loc] } {
     set origin_dir $::origin_dir_loc
  }
  set str_bd_folder [file normalize ${origin_dir}]
  set str_bd_filepath ${str_bd_folder}/${design_name}/${design_name}.bd

  # 1. Check if design exists in memory
  set list_existing_designs [get_bd_designs -quiet $design_name]
  if { $list_existing_designs ne "" } {
     puts "INFO: Das Design <$design_name> ist bereits im Speicher geöffnet. Es wird verwendet."
     current_bd_design $design_name
     set design_opened 1
  }

  # 2. Check if design exists on disk within project
  if { $design_opened == 0 } {
      set list_existing_designs [get_files -quiet */${design_name}.bd]
      if { $list_existing_designs ne "" } {
         puts "INFO: Das Design <$design_name> existiert auf der Festplatte. Es wird geöffnet."
         open_bd_design $list_existing_designs
         current_bd_design $design_name
         set design_opened 1
      }
  }

  # 3. Create new remote BD if it doesn't exist
  if { $design_opened == 0 } {
      puts "INFO: Erstelle neues Design <$design_name>."
      create_bd_design -dir $str_bd_folder $design_name
  }
  
} else {
  # Create regular design flow
  set list_existing_designs [get_bd_designs -quiet $design_name]
  if { $list_existing_designs ne "" } {
      current_bd_design $design_name
  } else {
      if { [catch {create_bd_design $design_name} errmsg] } {
         common::send_gid_msg -ssname BD::TCL -id 2038 -severity "INFO" "Please set a different value to variable <design_name>."
         return 1
      }
  }
}

current_bd_design $design_name

set bCheckIPsPassed 1
##################################################################
# CHECK IPs
##################################################################
set bCheckIPs 1
if { $bCheckIPs == 1 } {
   set list_check_ips "\ 
xilinx.com:ip:xlslice:1.0\
xilinx.com:ip:c_counter_binary:12.0\
xilinx.com:ip:proc_sys_reset:5.0\
xilinx.com:ip:clk_wiz:6.0\
xilinx.com:ip:processing_system7:5.5\
"

   set list_ips_missing ""
   common::send_gid_msg -ssname BD::TCL -id 2011 -severity "INFO" "Checking if the following IPs exist in the project's IP catalog: $list_check_ips ."

   foreach ip_vlnv $list_check_ips {
      set ip_obj [get_ipdefs -all $ip_vlnv]
      if { $ip_obj eq "" } {
         lappend list_ips_missing $ip_vlnv
      }
   }

   if { $list_ips_missing ne "" } {
      catch {common::send_gid_msg -ssname BD::TCL -id 2012 -severity "ERROR" "The following IPs are not found in the IP Catalog:\n  $list_ips_missing\n\nResolution: Please add the repository containing the IP(s) to the project." }
      set bCheckIPsPassed 0
   }

}

if { $bCheckIPsPassed != 1 } {
  common::send_gid_msg -ssname BD::TCL -id 2023 -severity "WARNING" "Will not continue with creation of design due to the error(s) above."
  return 3
}

##################################################################
# DESIGN PROCs
##################################################################

proc create_root_design { parentCell } {

  variable script_folder
  variable design_name

  if { $parentCell eq "" } {
     set parentCell [get_bd_cells /]
  }

  set parentObj [get_bd_cells $parentCell]
  if { $parentObj == "" } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2090 -severity "ERROR" "Unable to find parent cell <$parentCell>!"}
     return
  }

  set parentType [get_property TYPE $parentObj]
  if { $parentType ne "hier" } {
     catch {common::send_gid_msg -ssname BD::TCL -id 2091 -severity "ERROR" "Parent <$parentObj> has TYPE = <$parentType>. Expected to be <hier>."}
     return
  }

  set oldCurInst [current_bd_instance .]
  current_bd_instance $parentObj

  # =========================================================================
  # WICHTIG: Da das Design nun wiederverwendet wird, nutzen wir 'catch', 
  # damit Vivado nicht abstürzt, wenn Ports oder IP-Cores bereits existieren.
  # =========================================================================

  # Create interface ports
  catch { set FIXED_IO [ create_bd_intf_port -mode Master -vlnv xilinx.com:display_processing_system7:fixedio_rtl:1.0 FIXED_IO ] }

  # Create ports
  catch {
      set areset [ create_bd_port -dir I -type rst areset ]
      set_property -dict [ list CONFIG.POLARITY {ACTIVE_HIGH} ] $areset
  }
  catch {
      set clk125 [ create_bd_port -dir I -type clk -freq_hz 125000000 clk125 ]
      set_property -dict [ list CONFIG.ASSOCIATED_RESET {areset} ] $clk125
  }
  catch { set heartbeat [ create_bd_port -dir O -from 0 -to 0 heartbeat ] }
  catch { set locked [ create_bd_port -dir O locked ] }
  catch {
      set proc_areset [ create_bd_port -dir I -type rst proc_areset ]
      set_property -dict [ list CONFIG.POLARITY {ACTIVE_HIGH} ] $proc_areset
  }

  # Create instance: xlslice_0, and set properties
  catch {
      set xlslice_0 [ create_bd_cell -type ip -vlnv xilinx.com:ip:xlslice:1.0 xlslice_0 ]
      set_property -dict [list \
        CONFIG.DIN_FROM {26} \
        CONFIG.DIN_TO {26} \
        CONFIG.DIN_WIDTH {27} \
        CONFIG.DOUT_WIDTH {1} \
      ] $xlslice_0
  }

  # Create instance: c_counter_binary_0, and set properties
  catch {
      set c_counter_binary_0 [ create_bd_cell -type ip -vlnv xilinx.com:ip:c_counter_binary:12.0 c_counter_binary_0 ]
      set_property -dict [list \
        CONFIG.CE {true} \
        CONFIG.Output_Width {27} \
      ] $c_counter_binary_0
  }

  # Create instance: proc_sys_reset_0
  catch { set proc_sys_reset_0 [ create_bd_cell -type ip -vlnv xilinx.com:ip:proc_sys_reset:5.0 proc_sys_reset_0 ] }

  # Create instance: clk_wiz_0, and set properties
  catch {
      set clk_wiz_0 [ create_bd_cell -type ip -vlnv xilinx.com:ip:clk_wiz:6.0 clk_wiz_0 ]
      set_property -dict [list \
        CONFIG.CLKIN1_JITTER_PS {80.0} \
        CONFIG.CLKOUT1_JITTER {124.615} \
        CONFIG.CLKOUT1_PHASE_ERROR {96.948} \
        CONFIG.MMCM_CLKFBOUT_MULT_F {8.000} \
        CONFIG.MMCM_CLKIN1_PERIOD {8.000} \
        CONFIG.PRIM_IN_FREQ {125} \
      ] $clk_wiz_0
  }

  # =========================================================================
  # DEINE EIGENEN ANPASSUNGEN FÜR PROCESSING SYSTEM & MEMORY (Unverändert)
  # =========================================================================

  if {[llength [get_bd_cells processing_system7_0]] == 0} {
      puts "Cell does not exist. Creating it."
      create_bd_cell -type ip -vlnv xilinx.com:ip:processing_system7:5.5 processing_system7_0
  } else {
      puts "Cell processing_system7_0 already exists."
  }
  
  set_property -dict [list \
  CONFIG.PCW_UIPARAM_DDR_ENABLE {0} \
  CONFIG.PCW_USE_M_AXI_GP0 {0} \
  CONFIG.PCW_USE_S_AXI_HP0 {1} \
  CONFIG.PCW_EN_CLK0_PORT {0} \
  ] [get_bd_cells processing_system7_0]
  
  set_property -dict [list \
  CONFIG.PCW_UIPARAM_DDR_BOARD_DELAY0 {0.221}  \
  CONFIG.PCW_UIPARAM_DDR_BOARD_DELAY1 {0.222}  \
  CONFIG.PCW_UIPARAM_DDR_BOARD_DELAY2 {0.217}  \
  CONFIG.PCW_UIPARAM_DDR_BOARD_DELAY3 {0.244}  \
  CONFIG.PCW_UIPARAM_DDR_DQS_TO_CLK_DELAY_0 {-0.05}  \
  CONFIG.PCW_UIPARAM_DDR_DQS_TO_CLK_DELAY_1 {-0.044}  \
  CONFIG.PCW_UIPARAM_DDR_DQS_TO_CLK_DELAY_2 {-0.035}  \
  CONFIG.PCW_UIPARAM_DDR_DQS_TO_CLK_DELAY_3 {-0.1}  \
  CONFIG.PCW_UIPARAM_DDR_ENABLE {1}  \
  CONFIG.PCW_UIPARAM_DDR_PARTNO {MT41J256M16 RE-125}  \
  CONFIG.PCW_UIPARAM_DDR_TRAIN_DATA_EYE {1}  \
  CONFIG.PCW_UIPARAM_DDR_TRAIN_READ_GATE {1}  \
  CONFIG.PCW_UIPARAM_DDR_TRAIN_WRITE_LEVEL {1}  \
  ] [get_bd_cells processing_system7_0]
  
  catch { create_bd_intf_port -mode Master -vlnv xilinx.com:interface:ddrx_rtl:1.0 DDR }
  catch { connect_bd_intf_net [get_bd_intf_pins processing_system7_0/DDR] [get_bd_intf_ports DDR] }
  
  catch {
      create_bd_cell -type ip -vlnv xilinx.com:ip:axi_protocol_converter:2.1 axi_protocol_convert_0
      set_property -dict [list CONFIG.SI_PROTOCOL.VALUE_SRC USER CONFIG.MI_PROTOCOL.VALUE_SRC USER CONFIG.DATA_WIDTH.VALUE_SRC USER] [get_bd_cells axi_protocol_convert_0]
      set_property -dict [list \
        CONFIG.DATA_WIDTH {64} \
        CONFIG.MI_PROTOCOL {AXI3} \
        CONFIG.TRANSLATION_MODE {2} \
      ] [get_bd_cells axi_protocol_convert_0]
  }
  
  catch { create_bd_cell -type ip -vlnv xilinx.com:ip:axi_dwidth_converter:2.1 axi_dwidth_converter_0 }
  
  # Create interface connections (Using catch so it doesn't fail if already connected)
  catch { connect_bd_intf_net -intf_net processing_system7_0_FIXED_IO [get_bd_intf_pins processing_system7_0/FIXED_IO] [get_bd_intf_ports FIXED_IO] }
  catch { connect_bd_intf_net [get_bd_intf_pins axi_protocol_convert_0/S_AXI] [get_bd_intf_pins axi_dwidth_converter_0/M_AXI] }
  catch { connect_bd_intf_net [get_bd_intf_pins axi_protocol_convert_0/M_AXI] [get_bd_intf_pins processing_system7_0/S_AXI_HP0] }
  
  # Create port connections
  catch { connect_bd_net [get_bd_pins axi_dwidth_converter_0/s_axi_aclk] [get_bd_pins axi_protocol_convert_0/aclk] }
  catch { connect_bd_net [get_bd_pins axi_protocol_convert_0/aresetn] [get_bd_pins axi_dwidth_converter_0/s_axi_aresetn] }
  catch { connect_bd_net [get_bd_pins processing_system7_0/S_AXI_HP0_ACLK] [get_bd_pins axi_dwidth_converter_0/s_axi_aclk] }

  catch {
      connect_bd_net -net areset_1  [get_bd_ports areset] \
      [get_bd_pins clk_wiz_0/reset]
  }
  catch {
      connect_bd_net -net c_counter_binary_0_Q  [get_bd_pins c_counter_binary_0/Q] \
      [get_bd_pins xlslice_0/Din]
  }
  catch {
      connect_bd_net -net clk125_1  [get_bd_ports clk125] \
      [get_bd_pins clk_wiz_0/clk_in1]
  }
  catch {
      connect_bd_net -net clk_wiz_0_locked  [get_bd_pins clk_wiz_0/locked] \
      [get_bd_ports locked] \
      [get_bd_pins c_counter_binary_0/CE] \
      [get_bd_pins proc_sys_reset_0/dcm_locked]
  }
  catch {
      connect_bd_net -net mig_7series_0_ui_clk  [get_bd_pins clk_wiz_0/clk_out1] \
      [get_bd_pins c_counter_binary_0/CLK] \
      [get_bd_pins proc_sys_reset_0/slowest_sync_clk]
  }
  catch {
      connect_bd_net -net proc_areset_1  [get_bd_ports proc_areset] \
      [get_bd_pins proc_sys_reset_0/ext_reset_in]
  }
  catch {
      connect_bd_net -net xlslice_0_Dout  [get_bd_pins xlslice_0/Dout] \
      [get_bd_ports heartbeat]
  }
  
  # Note: mdm_1 and microblaze_0 are referenced here but aren't created in the above script. 
  # Catching it ensures it won't crash if they don't exist yet.
  catch { connect_bd_net [get_bd_pins mdm_1/Interrupt] [get_bd_pins microblaze_0/Interrupt] }

  catch { group_bd_cells ext_memory [get_bd_cells axi_dwidth_converter_0] [get_bd_cells axi_protocol_convert_0] [get_bd_cells processing_system7_0] }
  
  catch { create_bd_intf_pin -mode Slave -vlnv xilinx.com:interface:aximm_rtl:1.0 ext_memory/S_AXI }
  catch { connect_bd_intf_net -boundary_type upper [get_bd_intf_pins ext_memory/S_AXI] [get_bd_intf_pins ext_memory/axi_dwidth_converter_0/S_AXI] }
  
  catch { create_bd_pin -dir I ext_memory/aclk }
  catch { connect_bd_net [get_bd_pins ext_memory/aclk] [get_bd_pins ext_memory/axi_dwidth_converter_0/s_axi_aclk] }
  
  catch { create_bd_pin -dir I ext_memory/aresetn }
  catch { connect_bd_net [get_bd_pins ext_memory/aresetn] [get_bd_pins ext_memory/axi_dwidth_converter_0/s_axi_aresetn] }

  # Restore current instance
  current_bd_instance $oldCurInst

  validate_bd_design
  save_bd_design
}
# End of create_root_design()

##################################################################
# MAIN FLOW
##################################################################

create_root_design ""

make_wrapper -files [get_files ./bd/design_1/design_1.bd] -top
add_files -norecurse ./bd/design_1/hdl/design_1_wrapper.v
